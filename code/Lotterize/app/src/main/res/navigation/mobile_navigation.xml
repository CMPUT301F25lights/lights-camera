<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.example.lotterize.ui.home.HomeFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_notifications"
        android:name="com.example.lotterize.ui.notifications.NotificationsFragment"
        android:label="@string/title_notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/navigation_addEvents"
        android:name="com.example.lotterize.ui.addEvents.AddEventsFragment"
        android:label="@string/title_AddEvents"
        tools:layout="@layout/fragment_add_events" />

    <fragment
        android:id="@+id/navigation_eventsregistered"
        android:name="com.example.lotterize.ui.eventsRegistered.EventsRegisteredFragment"
        android:label="@string/title_EventsRegistered"
        tools:layout="@layout/fragment_events_registered" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.lotterize.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

</navigation>